# Smart AI Assistant - Environment Configuration

# Backend Server Configuration
PROJECT_NAME="Smart AI Assistant"
PORT=8000
HOST="127.0.0.1"

# Database Configuration (SQLite)
DATABASE_URL="sqlite:///./smart_assistant.db"

# AI Integration - Option 1: Google Gemini API (Recommended & Free)
# Obtain a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# AI Integration - Option 2: OpenAI API (or Groq, OpenRouter, Local Ollama)
# Obtain an OpenAI key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_API_BASE="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
